DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_learning_radar
APP_SECRET_KEY=replace-with-a-base64-encoded-secret-at-least-32-bytes
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# DATABASE_URL automatically selects the persistent Prisma repositories.
# APP_SECRET_KEY is encryption key material and must never be stored in PostgreSQL.

# Manual run trigger: the admin console dispatches the ingest-daily workflow on
# GitHub Actions. The token needs repo scope with Actions write permission.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/ai-learning-radar
# GITHUB_WORKFLOW_REF=main
# GITHUB_WORKFLOW_FILE=ingest-daily.yml
